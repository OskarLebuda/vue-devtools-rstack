{
  "name": "@vue-devtools-rstack/core",
  "type": "module",
  "version": "0.1.0",
  "description": "Shared server-side logic for Vue DevTools integration with Rspack/Rsbuild",
  "license": "MIT",
  "homepage": "https://github.com/olebuda/rspack-vue-devtools#readme",
  "keywords": [
    "vue-devtools",
    "rspack",
    "rsbuild",
    "dx",
    "rstack"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    },
    "./inspector-loader": "./loader.mjs",
    "./append-loader": "./append-loader.mjs",
    "./inspector-runtime": "./inspector-runtime/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "loader.mjs",
    "append-loader.mjs",
    "inspector-runtime"
  ],
  "scripts": {
    "build": "rslib build",
    "dev": "rslib build --watch",
    "check:publish": "publint && attw --pack ."
  },
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "dependencies": {
    "@vue/compiler-dom": "^3.5.0",
    "@vue/devtools-core": "8.1.5",
    "@vue/devtools-kit": "8.1.5",
    "@vue/devtools-shared": "8.1.5",
    "chokidar": "^5.0.0",
    "fast-glob": "^3.3.3",
    "image-meta": "^0.2.2",
    "kolorist": "^1.8.0",
    "launch-editor-middleware": "^2.14.1",
    "magic-string": "^1.1.0",
    "pathe": "^2.0.3",
    "perfect-debounce": "^2.1.0",
    "sirv": "^3.0.2",
    "vite-plugin-vue-devtools": "8.1.5",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.58.12",
    "@rslib/core": "^0.23.2",
    "@types/node": "^26.1.1",
    "@types/ws": "^8.18.1",
    "typescript": "^7.0.2",
    "vue": "^3.5.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=20.19"
  }
}
