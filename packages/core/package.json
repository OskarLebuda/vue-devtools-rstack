{
  "name": "@vue-devtools-rstack/core",
  "type": "module",
  "version": "0.2.0-beta.0",
  "description": "Shared server-side logic for Vue DevTools integration with Rspack/Rsbuild",
  "license": "MIT",
  "author": "Oskar Lebuda",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OskarLebuda/vue-devtools-rstack.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/OskarLebuda/vue-devtools-rstack/issues"
  },
  "homepage": "https://github.com/OskarLebuda/vue-devtools-rstack#readme",
  "keywords": [
    "vue-devtools",
    "rspack",
    "rsbuild",
    "dx",
    "rstack"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    },
    "./append-loader": "./append-loader.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "append-loader.mjs"
  ],
  "scripts": {
    "build": "rslib build",
    "dev": "rslib build --watch",
    "check:publish": "publint && attw --pack ."
  },
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "dependencies": {
    "@devframes/hub": "1.0.0",
    "@devframes/hub-ui": "1.0.0",
    "devframe": "1.0.0",
    "pathe": "^2.0.3",
    "sirv": "^3.0.2",
    "vite-plugin-vue-devtools": "9.0.0-beta.0"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.58.12",
    "@rslib/core": "^0.23.2",
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2",
    "vue": "^3.5.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=20.19"
  }
}
