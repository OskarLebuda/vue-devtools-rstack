{
  "name": "rsbuild-plugin-vue-devtools",
  "type": "module",
  "version": "0.1.0",
  "description": "An Rsbuild plugin for Vue DevTools — feature parity with vite-plugin-vue-devtools",
  "license": "MIT",
  "homepage": "https://github.com/olebuda/rspack-vue-devtools#readme",
  "keywords": [
    "vue-devtools",
    "rsbuild",
    "rsbuild-plugin",
    "rspack",
    "dx"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@vue-devtools-rspack/core": "workspace:*",
    "kolorist": "^1.8.0"
  },
  "peerDependencies": {
    "@rsbuild/core": "^1.0.0 || ^2.0.0"
  },
  "devDependencies": {
    "@rsbuild/core": "^2.1.7",
    "@types/node": "^24.0.0",
    "tsdown": "^0.22.13",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
