{
  "name": "rspack-plugin-vue-devtools",
  "type": "module",
  "version": "0.1.0",
  "description": "An Rspack plugin for Vue DevTools - feature parity with vite-plugin-vue-devtools",
  "license": "MIT",
  "homepage": "https://github.com/olebuda/rspack-vue-devtools#readme",
  "keywords": [
    "vue-devtools",
    "rspack",
    "rspack-plugin",
    "dx"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./middleware": {
      "types": "./dist/middleware.d.ts",
      "default": "./dist/middleware.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rslib build",
    "dev": "rslib build --watch",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@vue-devtools-rspack/core": "workspace:*",
    "kolorist": "^1.8.0"
  },
  "peerDependencies": {
    "@rspack/core": "^1.0.0 || ^2.0.0"
  },
  "peerDependenciesMeta": {
    "@rspack/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.58.12",
    "@rslib/core": "^0.23.2",
    "@rspack/core": "^2.1.5",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=20.19"
  }
}
