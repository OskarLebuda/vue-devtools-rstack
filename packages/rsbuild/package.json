{
  "name": "@vue-devtools-rstack/rsbuild",
  "type": "module",
  "version": "0.1.0",
  "description": "An Rsbuild plugin for Vue DevTools - feature parity with vite-plugin-vue-devtools",
  "license": "MIT",
  "homepage": "https://github.com/olebuda/rspack-vue-devtools#readme",
  "keywords": [
    "vue-devtools",
    "rsbuild",
    "rsbuild-plugin",
    "rspack",
    "dx",
    "rstack"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rslib build",
    "dev": "rslib build --watch",
    "check:publish": "publint && attw --pack ."
  },
  "dependencies": {
    "@vue-devtools-rstack/core": "workspace:*",
    "kolorist": "^1.8.0"
  },
  "peerDependencies": {
    "@rsbuild/core": "^1.0.0 || ^2.0.0"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.58.12",
    "@rsbuild/core": "^2.1.7",
    "@rslib/core": "^0.23.2",
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=20.19"
  }
}
