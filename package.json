{
  "name": "vue-devtools-rspack-monorepo",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "pnpm --filter \"./packages/*\" -r run build",
    "dev": "pnpm --filter playground-rsbuild-app run dev",
    "typecheck": "pnpm --filter \"./packages/*\" -r run typecheck",
    "test": "pnpm --filter \"./packages/*\" -r run test",
    "e2e": "pnpm --filter e2e run test",
    "smoke:pack": "node scripts/smoke-pack.mjs",
    "lint": "rslint",
    "lint:fix": "rslint --fix"
  },
  "devDependencies": {
    "@rslint/core": "^0.7.1",
    "playwright-core": "^1.61.1"
  }
}
