{
  "name": "vue-devtools-rstack-monorepo",
  "private": true,
  "version": "0.2.0-beta.0",
  "packageManager": "pnpm@10.28.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "pnpm --filter \"./packages/*\" -r run build",
    "dev": "pnpm --filter playground-rsbuild-app run dev",
    "typecheck": "rslint --type-check-only",
    "e2e": "pnpm --filter e2e run test",
    "lint": "rslint --type-check",
    "lint:fix": "rslint --fix --type-check",
    "check:publish": "pnpm --filter \"./packages/*\" -r run check:publish",
    "release": "bumpp"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@rslint/core": "^0.7.1",
    "publint": "^0.3.22"
  }
}
